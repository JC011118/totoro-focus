{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "companion",
  "description": "The floating companion widget: render state and send timer commands.",
  "windows": [
    "companion"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-snapshot",
    "allow-start-focus",
    "allow-start-break",
    "allow-pause",
    "allow-resume",
    "allow-end-session",
    "allow-dismiss",
    "allow-get-active-pack",
    "allow-hide-companion",
    "allow-open-settings",
    "allow-get-app-info",
    "allow-replay-animation"
  ]
}
