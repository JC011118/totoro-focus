{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Totoro Focus",
  "version": "0.1.0",
  "identifier": "io.github.jc011118.totorofocus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' pack: http://pack.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A calm offline focus timer with a desktop companion.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
