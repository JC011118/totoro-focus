{
  "format": 1,
  "id": "fixture-sprout",
  "name": "Sprout (test fixture)",
  "author": "Totoro Focus contributors",
  "license": "CC0-1.0",
  "description": "A tiny original sprout used by the focus-core pack tests.",
  "rendering": "smooth",
  "animations": {
    "idle": {
      "sheet": "sheet.svg", "frameWidth": 64, "frameHeight": 64,
      "frames": 4, "fps": 4, "loop": true,
      "row": 0, "column": 0, "sheetColumns": 4, "sheetRows": 2
    },
    "focus": {
      "sheet": "sheet.svg", "frameWidth": 64, "frameHeight": 64,
      "frames": 2, "fps": 2, "loop": true,
      "row": 1, "column": 0, "sheetColumns": 4, "sheetRows": 2,
      "stillFrame": 1, "frameDurationsMs": [900, 300]
    },
    "react": {
      "sheet": "react sheet.svg", "frameWidth": 64, "frameHeight": 64,
      "frames": 3, "fps": 10, "loop": false
    }
  },
  "fallbacks": { "paused": "focus" },
  "palettes": {
    "evening": {
      "background": "#2b2238", "surface": "rgba(60, 48, 80, 0.9)", "text": "#f3ead8",
      "muted": "hsl(260deg 15% 70%)", "accent": "#e9a86b", "ring": "#e9a86b",
      "ringTrack": "#ffffff22", "characterFilter": "brightness(0.9) saturate(0.9)"
    }
  }
}
